#!/bin/bash
set -e
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
export PATH="$SCRIPT_DIR:$PATH"
export SRCDIR=$SCRIPT_DIR/../../../src
export PGSTACDIR=$SRCDIR/pgstac

echo $SCRIPT_DIR
echo $SRCDIR
echo $PGSTACDIR

if [[ "${CI}" ]]; then
    set -x
fi

function usage() {
    echo -n \
        "Usage: $(basename "$0")
Run PgSTAC tests.
This scripts is meant to be run inside the dev container.

"
}

function setuptestdb(){
    cd $PGSTACDIR
    psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_db_template;
CREATE DATABASE pgstac_test_db_template;
ALTER DATABASE pgstac_test_db_template SET CLIENT_MIN_MESSAGES TO WARNING;
ALTER DATABASE pgstac_test_db_template SET SEARCH_PATH to pgstac, public;
\connect pgstac_test_db_template;
\i pgstac.sql
DO \$\$
BEGIN
    INSERT INTO queryables (name, definition, property_wrapper, property_index_type) VALUES
    ('eo:cloud_cover','{"$ref": "https://stac-extensions.github.io/eo/v1.0.0/schema.json#/definitions/fieldsproperties/eo:cloud_cover"}','to_int','BTREE')
    ON CONFLICT DO NOTHING;
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE '%', SQLERRM USING ERRCODE = SQLSTATE;
END
\$\$;
EOSQL
}

function test_formatting(){
    cd $SRCDIR/pypgstac

    echo "Running ruff"
    ruff check src/pypgstac tests

    echo "Running mypy"
    mypy src/pypgstac

    echo "Checking if there are any staged migrations."
    find $SRCDIR/pgstac/migrations | grep 'staged' && { echo "There are staged migrations in pypgstac/migrations. Please check migrations and remove staged suffix."; exit 1; }


    VERSION=$(python -c "from pypgstac.version import __version__; print(__version__)")
    echo $VERSION
    if echo $VERSION | grep "dev"; then
        VERSION="unreleased"
    fi

    echo "Checking whether base sql migration exists for pypgstac version."
    [ -f $SRCDIR/pgstac/migrations/pgstac."${VERSION}".sql ] || { echo "****FAIL No Migration exists pypgstac/migrations/pgstac.${VERSION}.sql"; exit 1; }

    echo "Congratulations! All formatting tests pass."
}

function test_pgtap(){
cd $PGSTACDIR
TEMPLATEDB=${1:-pgstac_test_db_template}
psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_pgtap WITH (force);
CREATE DATABASE pgstac_test_pgtap TEMPLATE $TEMPLATEDB;
ALTER DATABASE pgstac_test_pgtap SET client_min_messages to $CLIENTMESSAGES;

EOSQL
TESTOUTPUT=$(psql -X -q -v ON_ERROR_STOP=1 -f $PGSTACDIR/tests/pgtap.sql pgstac_test_pgtap)
psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_pgtap WITH (force);
EOSQL
# finish() reports a plan that does not match the tests run as a diagnostic comment rather than a
# failed assertion, so it is looked for as well; the count it reports is what plan() must be set to.
if [[ $(echo "$TESTOUTPUT" | grep -e '^not' -e '^# Looks like') ]]; then
    echo "PGTap tests failed."
    echo "$TESTOUTPUT" | awk NF
    exit 1
else
    echo "PGTap Tests Passed! ($(echo "$TESTOUTPUT" | grep -c '^ok') assertions)"
fi

}

function test_basicsql(){
TEMPLATEDB=${1:-pgstac_test_db_template}
cd $PGSTACDIR
psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_basicsql WITH (force);
CREATE DATABASE pgstac_test_basicsql TEMPLATE $TEMPLATEDB;
ALTER DATABASE pgstac_test_basicsql SET search_path to pgstac, public;
ALTER DATABASE pgstac_test_basicsql SET client_min_messages to $CLIENTMESSAGES;
ALTER DATABASE pgstac_test_basicsql SET pgstac.context to 'on';
ALTER DATABASE pgstac_test_basicsql SET pgstac."default_filter_lang" TO 'cql-json';
\connect pgstac_test_basicsql
\copy collections (content) FROM 'tests/testdata/collections.ndjson';
\copy items_staging (content) FROM 'tests/testdata/items.ndjson'
EOSQL

for SQLFILE in tests/basic/*.sql; do
    SQLOUTFILE=${SQLFILE}.out
    if [[ $CREATEBASICSQLOUT == 1 && ! -f $SQLOUTFILE ]]; then
        TMPFILE=$SQLOUTFILE
    else
        TMPFILE=$(mktemp)
        trap 'rm "$TMPFILE"' 0 2 3 15
    fi


    cd $PGSTACDIR

    echo "Running basic tests for $SQLFILE"
    psql -X -t -a -v ON_ERROR_STOP=1 pgstac_test_basicsql \
        -c "BEGIN;" \
        -f $SQLFILE \
        -c "ROLLBACK;" \
        | sed -e '/^ROLLBACK/d' -e '/^BEGIN/d' >"$TMPFILE"

    # In create mode TMPFILE is the output file itself, so there is nothing to compare
    # against: say what happened rather than diff a file with itself and report a pass.
    if [[ "$TMPFILE" == "$SQLOUTFILE" ]]; then
        echo "CREATED $SQLOUTFILE -- review it before committing"
    else
        diff -Z -b -w -B --strip-trailing-cr --suppress-blank-empty -C 1 "$TMPFILE" $SQLOUTFILE && echo "TEST $SQLFILE PASSED" || { echo "***TEST FOR $SQLFILE FAILED***"; exit 1; }
    fi

done
psql -X -q -c "DROP DATABASE IF EXISTS pgstac_test_basicsql WITH (force);";
}

function test_pypgstac(){
[[ $MESSAGELOG == 1 ]] && VERBOSE="-vvv"
TEMPLATEDB=${1:-pgstac_test_db_template}
    cd $SRCDIR/pypgstac
    python -m venv venv
    source venv/bin/activate
    pip install --cache /tmp/.pipcache --upgrade pip
    pip install --cache /tmp/.pipcache -e . --no-deps
    psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_pypgstac WITH (force);
CREATE DATABASE pgstac_test_pypgstac TEMPLATE $TEMPLATEDB;
ALTER DATABASE pgstac_test_pypgstac SET client_min_messages to $CLIENTMESSAGES;
EOSQL
    pytest tests $VERBOSE
    psql -X -q -c "DROP DATABASE IF EXISTS pgstac_test_pypgstac WITH (force)";
}

function test_pgdump(){
    echo "=== Testing pg_dump / pg_restore ==="
    TEMPLATEDB=${1:-pgstac_test_db_template}
    DUMPFILE=$(mktemp /tmp/pgstac_dump.XXXXXX)
    trap 'rm -f "$DUMPFILE"' 0 2 3 15

    # Create source database with sample data
    psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_dump_src WITH (force);
CREATE DATABASE pgstac_test_dump_src TEMPLATE $TEMPLATEDB;
ALTER DATABASE pgstac_test_dump_src SET search_path to pgstac, public;
ALTER DATABASE pgstac_test_dump_src SET client_min_messages to $CLIENTMESSAGES;
\connect pgstac_test_dump_src
\copy collections (content) FROM '$PGSTACDIR/tests/testdata/collections.ndjson';
\copy items_staging (content) FROM '$PGSTACDIR/tests/testdata/items.ndjson'
-- Exercise base_items rows, an untagged item and a tagged one in the dump.
UPDATE collections SET content = jsonb_set(
    content, '{item_assets}', '{"thumbnail":{"type":"image/png"}}'::jsonb
) WHERE id = 'pgstac-test-collection';
SELECT create_item(get_item(id, collection) || '{"id":"pgdump-post-edit"}'::jsonb)
FROM items WHERE collection = 'pgstac-test-collection' LIMIT 1;
EOSQL

    # Capture counts from source
    SRC_COLLECTIONS=$(psql -X -t -A -c "SELECT count(*) FROM pgstac.collections;" pgstac_test_dump_src)
    SRC_ITEMS=$(psql -X -t -A -c "SELECT count(*) FROM pgstac.items;" pgstac_test_dump_src)
    SRC_SEARCH=$(psql -X -t -A -c "SELECT count(*) FROM (SELECT * FROM pgstac.search('{}')) s;" pgstac_test_dump_src)
    SRC_VERSION=$(psql -X -t -A -c "SELECT pgstac.get_version();" pgstac_test_dump_src)
    SRC_BASEITEMS=$(psql -X -t -A -c "SELECT count(*) FROM pgstac.base_items;" pgstac_test_dump_src)
    SRC_HYDRATED=$(psql -X -t -A -c "SELECT md5(string_agg(pgstac.get_item(id, collection)::text, '' ORDER BY collection ASC, id ASC)) FROM pgstac.items;" pgstac_test_dump_src)
    echo "Source: ${SRC_COLLECTIONS} collections, ${SRC_ITEMS} items, ${SRC_SEARCH} search results, version ${SRC_VERSION}, ${SRC_BASEITEMS} base items, hydrated ${SRC_HYDRATED}"

    # Dump with custom format
    echo "Running pg_dump -Fc ..."
    pg_dump -Fc --schema=pgstac -f "$DUMPFILE" pgstac_test_dump_src
    DUMPSIZE=$(stat -c%s "$DUMPFILE" 2>/dev/null || stat -f%z "$DUMPFILE" 2>/dev/null)
    echo "Dump file size: ${DUMPSIZE} bytes"

    if [ "$DUMPSIZE" -lt 1000 ]; then
        echo "***FAIL: pg_dump produced suspiciously small file (${DUMPSIZE} bytes)***"
        exit 1
    fi

    # Create target database and restore using pgstac_restore.
    # pgstac_restore detects PostGIS schema on the target, fixes the
    # search_path that pg_dump clears, and pipes through psql.
    psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_dump_dst WITH (force);
CREATE DATABASE pgstac_test_dump_dst;
ALTER DATABASE pgstac_test_dump_dst SET search_path to pgstac, public;
ALTER DATABASE pgstac_test_dump_dst SET client_min_messages to $CLIENTMESSAGES;
EOSQL

    echo "Running pgstac_restore ..."
    pgstac_restore \
        -d pgstac_test_dump_dst \
        --create-extensions \
        --no-roles \
        "$DUMPFILE"

    # Verify restored data matches source
    DST_COLLECTIONS=$(psql -X -t -A -c "SELECT count(*) FROM pgstac.collections;" pgstac_test_dump_dst)
    DST_ITEMS=$(psql -X -t -A -c "SELECT count(*) FROM pgstac.items;" pgstac_test_dump_dst)
    DST_SEARCH=$(psql -X -t -A -c "SELECT count(*) FROM (SELECT * FROM pgstac.search('{}')) s;" pgstac_test_dump_dst)
    DST_VERSION=$(psql -X -t -A -c "SELECT pgstac.get_version();" pgstac_test_dump_dst)
    DST_BASEITEMS=$(psql -X -t -A -c "SELECT count(*) FROM pgstac.base_items;" pgstac_test_dump_dst)
    DST_HYDRATED=$(psql -X -t -A -c "SELECT md5(string_agg(pgstac.get_item(id, collection)::text, '' ORDER BY collection ASC, id ASC)) FROM pgstac.items;" pgstac_test_dump_dst)
    echo "Restored: ${DST_COLLECTIONS} collections, ${DST_ITEMS} items, ${DST_SEARCH} search results, version ${DST_VERSION}, ${DST_BASEITEMS} base items, hydrated ${DST_HYDRATED}"

    FAILED=0
    if [ "$SRC_COLLECTIONS" != "$DST_COLLECTIONS" ]; then
        echo "***FAIL: collection count mismatch: source=${SRC_COLLECTIONS} restored=${DST_COLLECTIONS}***"
        FAILED=1
    fi
    if [ "$SRC_ITEMS" != "$DST_ITEMS" ]; then
        echo "***FAIL: item count mismatch: source=${SRC_ITEMS} restored=${DST_ITEMS}***"
        FAILED=1
    fi
    if [ "$SRC_SEARCH" != "$DST_SEARCH" ]; then
        echo "***FAIL: search result count mismatch: source=${SRC_SEARCH} restored=${DST_SEARCH}***"
        FAILED=1
    fi
    if [ "$SRC_VERSION" != "$DST_VERSION" ]; then
        echo "***FAIL: version mismatch: source=${SRC_VERSION} restored=${DST_VERSION}***"
        FAILED=1
    fi
    if [ "$SRC_BASEITEMS" != "$DST_BASEITEMS" ]; then
        echo "***FAIL: base_items count mismatch: source=${SRC_BASEITEMS} restored=${DST_BASEITEMS}***"
        FAILED=1
    fi
    if [ "$SRC_HYDRATED" != "$DST_HYDRATED" ]; then
        echo "***FAIL: hydrated item content mismatch: source=${SRC_HYDRATED} restored=${DST_HYDRATED}***"
        FAILED=1
    fi
    if [ "$DST_ITEMS" -eq 0 ]; then
        echo "***FAIL: restored database has 0 items***"
        FAILED=1
    fi
    if [ "$DST_BASEITEMS" -eq 0 ]; then
        echo "***FAIL: restored database has 0 base items***"
        FAILED=1
    fi

    # Cleanup
    rm -f "$DUMPFILE"
    psql -X -q -c "DROP DATABASE IF EXISTS pgstac_test_dump_src WITH (force);"
    psql -X -q -c "DROP DATABASE IF EXISTS pgstac_test_dump_dst WITH (force);"

    if [ "$FAILED" -eq 1 ]; then
        echo "***pg_dump/pg_restore test FAILED***"
        exit 1
    fi
    echo "pg_dump/pg_restore test PASSED!"
}

function test_migrations_with_data(){
    # test_migrations starts from an empty 0.3.0 database, so nothing there
    # exercises migrating a database that already holds collections, items and
    # partitions -- which is what every real upgrade is.
    local _prev_pgdatabase="${PGDATABASE:-}"
    psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_migration_data WITH (force);
CREATE DATABASE pgstac_test_migration_data;
ALTER DATABASE pgstac_test_migration_data SET search_path to pgstac, public;
ALTER DATABASE pgstac_test_migration_data SET client_min_messages to $CLIENTMESSAGES;
EOSQL
    export PGDATABASE=pgstac_test_migration_data

    # Once a release is staged its own base migration is the highest one present,
    # and migrating it to itself is a no-op that then fails on the legacy fixtures.
    local PREVIOUS THISVERSION
    THISVERSION=$(python -c "from pypgstac.version import __version__; print(__version__)")
    PREVIOUS=$(find $SRCDIR/pgstac/migrations -name "pgstac.*.sql" \
        | sed -En 's/^.*pgstac\.([0-9]+\.[0-9]+\.[0-9]+)\.sql$/\1/p' \
        | grep -v "^${THISVERSION}$" \
        | sort -Vr | head -1)
    echo "Populating a $PREVIOUS database, then migrating it."

    psql -X -q -v ON_ERROR_STOP=1 -f $SRCDIR/pgstac/migrations/pgstac.$PREVIOUS.sql >/dev/null
    psql -X -q -v ON_ERROR_STOP=1 -f $SRCDIR/pgstac/tests/migration/snapshot.sql

    echo "Adding queryables rows in the spellings only the old release accepted."
    psql -X -q -v ON_ERROR_STOP=1 <<'EOSQL'
SET SEARCH_PATH TO pgstac, public;
-- property_path spelled as the path expression the queryable was read through, and an empty
-- collection_ids meaning every collection. The current release accepts neither spelling and the
-- old one refuses the twin pair, so its constraint trigger is off while these are written. The
-- empty scoped twin is written first, so it is the older of the pair.
ALTER TABLE queryables DISABLE TRIGGER queryables_constraint_insert_trigger;
INSERT INTO queryables (name, collection_ids, definition, property_path, property_wrapper, property_index_type) VALUES
    ('mig_pp_chain',    NULL,         '{"type":"string"}',  'content->''a''->''b:c''',            NULL,     NULL),
    ('mig_pp_props',    NULL,         '{"type":"string"}',  'content -> ''properties'' -> ''x''', NULL,     NULL),
    ('mig_pp_quote',    NULL,         '{"type":"string"}',  'content->''it''''s''',               NULL,     NULL),
    ('mig_pp_opaque',   NULL,         '{"type":"string"}',  'content #> ''{a,b}''',               NULL,     NULL),
    ('mig_pp_none',     NULL,         '{"type":"string"}',  NULL,                                 NULL,     NULL),
    ('mig_scope_empty', '{}',         '{"type":"string"}',  NULL,                                 NULL,     NULL),
    ('mig_scope_one',   '{mig-flat}', '{"type":"string"}',  NULL,                                 NULL,     NULL),
    ('mig_scope_all',   NULL,         '{"type":"string"}',  NULL,                                 NULL,     NULL),
    ('mig_twin',        '{}',         '{"type":"string"}',  NULL,                                 NULL,     NULL),
    ('mig_twin',        NULL,         '{"type":"string"}',  NULL,                                 NULL,     NULL),
    ('eo:cloud_cover',  NULL,         '{"type":"integer"}', NULL,                                 'to_int', 'BTREE');
ALTER TABLE queryables ENABLE TRIGGER queryables_constraint_insert_trigger;
-- Kept outside the pgstac schema so the migration cannot touch it.
DROP TABLE IF EXISTS public.migration_queryables;
CREATE TABLE public.migration_queryables AS SELECT id, name FROM queryables;

-- A queue with work in it across the upgrade. The statistics entry has to be discarded
-- rather than run -- 998_idempotent_post queues every partition again once the migration
-- commits -- and anything else has to run before the schema it names changes under it.
DROP TABLE IF EXISTS public.mig_queue_ran;
DELETE FROM query_queue;
-- A partition that cannot exist, so a history row naming it can only mean this entry
-- ran; 998_idempotent_post queues a real one for every partition after the migration.
INSERT INTO query_queue (query) VALUES
    ('SELECT update_partition_stats(''_items_never'', ''f'');'),
    ('CREATE TABLE public.mig_queue_ran (a int);');
EOSQL

    cd $SRCDIR/pypgstac
    source venv/bin/activate
    pypgstac migrate
    pypgstac --version

    echo "Verifying nothing was lost."
    psql -X -q -v ON_ERROR_STOP=1 -f $SRCDIR/pgstac/tests/migration/verify.sql
    local _rc=$?

    echo "Verifying the queue was carried across the migration."
    psql -X -q -v ON_ERROR_STOP=1 <<'EOSQL'
SET SEARCH_PATH TO pgstac, public;
DO $$
DECLARE
    n bigint;
BEGIN
    IF to_regclass('public.mig_queue_ran') IS NULL THEN
        RAISE EXCEPTION 'a queued statement was not run before the migration';
    END IF;
    SELECT count(*) INTO n FROM query_queue;
    IF n <> 0 THEN
        RAISE EXCEPTION 'the queue was not drained by the migration, % left', n;
    END IF;
    IF EXISTS (
        SELECT FROM query_queue_history
        WHERE query = 'SELECT update_partition_stats(''_items_never'', ''f'');'
    ) THEN
        RAISE EXCEPTION 'a queued partition statistics update was run instead of discarded';
    END IF;
END
$$;
EOSQL

    echo "Verifying the queryables rows were converted, not dropped."
    psql -X -q -v ON_ERROR_STOP=1 <<'EOSQL'
SET SEARCH_PATH TO pgstac, public;
DO $$
DECLARE
    r record;
    n bigint;
    nparts bigint;
    nidx bigint;
BEGIN
    -- A legacy property_path becomes the keys its expression named, or NULL when it names none
    -- that can be read back. An empty scope becomes a global one.
    FOR r IN
        SELECT e.name, e.path, e.scope, q.id, q.property_path, q.collection_ids
        FROM (VALUES
            ('mig_pp_chain',    ARRAY['a','b:c'],        NULL::text[]),
            ('mig_pp_props',    ARRAY['properties','x'], NULL),
            ('mig_pp_quote',    ARRAY['it''s'],          NULL),
            ('mig_pp_opaque',   NULL::text[],            NULL),
            ('mig_pp_none',     NULL,                    NULL),
            ('mig_scope_empty', NULL,                    NULL),
            ('mig_scope_one',   NULL,                    ARRAY['mig-flat']),
            ('mig_scope_all',   NULL,                    NULL),
            ('mig_twin',        NULL,                    NULL)
        ) e(name, path, scope)
        LEFT JOIN queryables q ON q.name = e.name
    LOOP
        IF r.id IS NULL THEN
            RAISE EXCEPTION 'queryable % did not survive the migration', r.name;
        END IF;
        IF r.property_path IS DISTINCT FROM r.path THEN
            RAISE EXCEPTION 'queryable % has property_path %, expected %', r.name, r.property_path, r.path;
        END IF;
        IF r.collection_ids IS DISTINCT FROM r.scope THEN
            RAISE EXCEPTION 'queryable % has collection_ids %, expected %', r.name, r.collection_ids, r.scope;
        END IF;
    END LOOP;

    -- Of the pair the migration has to reduce, the older row is the one that stays.
    SELECT count(*) INTO n FROM queryables WHERE name = 'mig_twin';
    IF n <> 1 THEN
        RAISE EXCEPTION 'the mig_twin pair was reduced to % rows, expected 1', n;
    END IF;
    IF (SELECT id FROM queryables WHERE name = 'mig_twin')
        IS DISTINCT FROM (SELECT min(id) FROM public.migration_queryables WHERE name = 'mig_twin')
    THEN
        RAISE EXCEPTION 'the mig_twin pair kept the newer row';
    END IF;

    -- An ordinary indexed queryable keeps its one index per partition, and gains no second one.
    SELECT count(*) INTO nparts FROM partitions_view;
    SELECT count(*) INTO nidx FROM pg_index i
    JOIN pg_class t ON t.oid = i.indrelid
    WHERE t.relnamespace = 'pgstac'::regnamespace
        AND t.relname <> 'queryable_index_template'
        AND pg_get_indexdef(i.indexrelid) LIKE '%eo:cloud_cover%';
    IF nidx <> nparts THEN
        RAISE EXCEPTION 'eo:cloud_cover has % indexes over % partitions, expected one each', nidx, nparts;
    END IF;
END;
$$;
DROP TABLE public.migration_queryables;
EOSQL
    echo "Queryables conversions PASSED!"

    psql -X -q -c "DROP DATABASE IF EXISTS pgstac_test_migration_data WITH (force);" postgres
    export PGDATABASE="${_prev_pgdatabase}"
    if [ $_rc -ne 0 ]; then
        echo "***MIGRATION WITH DATA FAILED***"
        return 1
    fi
    echo "Migration with data PASSED!"
}

function test_idempotent_pre(){
    # 000_idempotent_pre is prepended to every incremental migration and migra
    # does not recreate an unchanged function it dropped, so against the current
    # schema it must drop nothing.
    cd $PGSTACDIR
    psql -X -q -v ON_ERROR_STOP=1 pgstac_test_db_template <<EOSQL
BEGIN;
CREATE TEMP TABLE pre AS
    SELECT oid::regprocedure::text AS sig FROM pg_proc WHERE pronamespace = 'pgstac'::regnamespace;
\i sql/000_idempotent_pre.sql
RESET ROLE;
DO \$\$
DECLARE
    dropped text;
BEGIN
    SELECT string_agg(sig, ', ') INTO dropped FROM (
        SELECT sig FROM pre
        EXCEPT
        SELECT oid::regprocedure::text FROM pg_proc WHERE pronamespace = 'pgstac'::regnamespace
    ) d;
    IF dropped IS NOT NULL THEN
        RAISE EXCEPTION '000_idempotent_pre.sql drops live function(s): %', dropped;
    END IF;
END
\$\$;
ROLLBACK;
EOSQL
    echo "000_idempotent_pre drops no live functions."
}

function test_migrations(){
    psql -X -q -v ON_ERROR_STOP=1 <<EOSQL
DROP DATABASE IF EXISTS pgstac_test_migration WITH (force);
CREATE DATABASE pgstac_test_migration;
ALTER DATABASE pgstac_test_migration SET search_path to pgstac, public;
ALTER DATABASE pgstac_test_migration SET client_min_messages to $CLIENTMESSAGES;
EOSQL
    local _prev_pgdatabase="${PGDATABASE:-}"
    export PGDATABASE=pgstac_test_migration
    echo "Migrating from version 0.3.0"
    cd $SRCDIR/pypgstac
    python -m venv venv
    source venv/bin/activate
    pip install --cache /tmp/.pipcache --upgrade pip
    pip install --cache /tmp/.pipcache -e .[dev,test,psycopg]

    pypgstac migrate --toversion 0.3.0
    pypgstac --version

    pypgstac migrate
    pypgstac --version

    echo "Running all tests against incrementally migrated database."
    test_pgtap pgstac_test_migration
    test_basicsql pgstac_test_migration
    test_pypgstac pgstac_test_migration
    psql -X -q -c "DROP DATABASE IF EXISTS pgstac_test_migration WITH (force);" postgres
    export PGDATABASE="${_prev_pgdatabase}"
}

FORMATTING=0
SETUPDB=0
PGTAP=0
BASICSQL=0
PYPGSTAC=0
MIGRATIONS=0
PGDUMP=0
MESSAGENOTICE=0
MESSAGELOG=0
CREATEBASICSQLOUT=0

while [[ $# -gt 0 ]]
    do
        key="$1"
        case $key in

            --help)
            usage
            exit 0
            shift
            ;;

            --v)
            MESSAGENOTICE=1
            shift
            ;;

            --vv)
            MESSAGEDEBUG=1
            shift
            ;;

            --formatting)
            FORMATTING=1
            shift
            ;;

            --pgtap)
            SETUPDB=1
            PGTAP=1
            shift
            ;;

            --basicsql)
            SETUPDB=1
            BASICSQL=1
            shift
            ;;

            --basicsql-createout)
            SETUPDB=1
            BASICSQL=1
            export CREATEBASICSQLOUT=1
            shift
            ;;

            --pypgstac)
            SETUPDB=1
            PYPGSTAC=1
            shift
            ;;

            --migrations)
            SETUPDB=1
            MIGRATIONS=1
            shift
            ;;

            --pgdump)
            SETUPDB=1
            PGDUMP=1
            shift
            ;;

            --nomigrations)
            SETUPDB=1
            PGTAP=1
            BASICSQL=1
            PYPGSTAC=1
            shift
            ;;

            *)    # unknown option
            usage
            exit 1;
            ;;
        esac
    done


CLIENTMESSAGES='warning'
[[ $MESSAGENOTICE -eq 1 ]] && CLIENTMESSAGES='notice'
[[ $MESSAGEDEBUG -eq 1 ]] && CLIENTMESSAGES='debug1'
echo $CLIENTMESSAGES

if [[ ($FORMATTING -eq 0) && ($SETUPDB -eq 0) && ($PGTAP -eq 0) && ($BASICSQL -eq 0) && ($PYPGSTAC -eq 0) && ($MIGRATIONS -eq 0) && ($PGDUMP -eq 0) ]]
then
    FORMATTING=1
    SETUPDB=1
    PGTAP=1
    BASICSQL=1
    PYPGSTAC=1
    MIGRATIONS=1
    PGDUMP=1
fi

[ $FORMATTING -eq 1 ] && test_formatting
[ $SETUPDB -eq 1 ] && setuptestdb
[ $PGTAP -eq 1 ] && test_pgtap
[ $BASICSQL -eq 1 ] && test_basicsql
[ $PYPGSTAC -eq 1 ] && test_pypgstac
[ $MIGRATIONS -eq 1 ] && test_idempotent_pre
[ $MIGRATIONS -eq 1 ] && test_migrations
[ $MIGRATIONS -eq 1 ] && test_migrations_with_data
[ $PGDUMP -eq 1 ] && test_pgdump

exit 0
